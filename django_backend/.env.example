# Azure AD SSO settings
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/{tenant_id}
AZURE_AD_REDIRECT_URI=http://localhost:3001/api/auth/callback/
AZURE_AD_SCOPE=openid profile email

# Where the frontend should get redirected when login succeeds or fails
FRONTEND_SUCCESS_URL=http://localhost:3000/
FRONTEND_ERROR_URL=http://localhost:3000/login
